#set -e
SCRIPT_HOME="$(dirname "$(readlink -f "${BASH_SOURCE}")")"
ROOT="$(dirname "${SCRIPT_HOME}")"

PATH_TO_SCRIPTS="$(dirname "${BASH_SOURCE}")"

(return 0 2>/dev/null) && SOURCED=1 || SOURCED=0

if [ "${SOURCED}" -eq 0 ]; then
	echo "Source this script (source ${BASH_SOURCE}) to setup bash " >&2
	echo "tab completion." >&2
fi

source "${ROOT}/docs/jauto-prof.bash-completion"
complete -F _jauto_prof_completions "${PATH_TO_SCRIPTS}/jauto-prof"
