# Backing helper for jauto-prof's bash tab completion. Not meant to be run by
# hand, and deliberately not marked executable (nor ever put on $PATH) so it
# doesn't itself show up as a tab-completion candidate; the completion
# function in docs/jauto-prof.bash-completion invokes it directly via bash.
set -e
SCRIPT_HOME="$(dirname "$(readlink -f "$0")")"
ROOT="$(dirname "${SCRIPT_HOME}")"

VENV="$ROOT/.venv"

export PYTHONPATH="${ROOT}/py-src"

exec "$VENV/bin/python3" -m jauto_profiler.jauto_completions "${@}"
