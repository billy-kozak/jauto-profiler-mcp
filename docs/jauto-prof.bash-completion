###############################################################################
# Bash tab completion for the jauto-prof CLI.
#
# This is scaffolding only: it locates the "jauto-completions" helper that
# ships next to jauto-prof and hands it COMP_WORDS; the helper (Python) does
# the actual completion logic and prints one candidate per line, which
# becomes COMPREPLY.
#
# Source this file (e.g. from ~/.bashrc) and make sure `jauto-prof` is on
# $PATH. If you invoke it via a path instead (e.g. ./scripts/jauto-prof or
# bin/jauto-prof), register that literal invocation too:
#
#   complete -F _jauto_prof_completions /path/to/jauto-prof
###############################################################################

_jauto_prof_completions()
{
	local cmd_path completions_script

	cmd_path="$1"
	if [[ "${cmd_path}" != */* ]]; then
		cmd_path="$(type -P -- "${cmd_path}")" || return
	fi

	completions_script="$(dirname -- "${cmd_path}")/jauto-completions"
	[ -f "${completions_script}" ] || return

	COMPREPLY=()
	mapfile -t COMPREPLY < <(bash "${completions_script}" "${COMP_WORDS[@]}")
}

complete -F _jauto_prof_completions jauto-prof
